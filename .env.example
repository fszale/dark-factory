# Optional server-side AI providers. Keep real values only in .env; never expose them to the browser.
OPENAI_API_KEY=
TYPESAFE_API_KEY=

# Server runtime (the web client reaches it through /api in development).
PORT=3000

# Require this code before AI calls on public deployments. Leave PUBLIC_MODE false for local use.
PUBLIC_MODE=false
BRICKWORKS_ACCESS_CODE=

# Optional process limits.
AI_GLOBAL_TOKEN_LIMIT=100000
SESSION_IDLE_MS=1800000

# Durable full event/command/lineage history. The default directory is .data/archives.
ARCHIVE_DIR=.data/archives
ARCHIVE_RETENTION_MS=86400000
ARCHIVE_SESSION_BYTES=67108864
ARCHIVE_GLOBAL_BYTES=268435456

# Virtual vehicle order desk (DF-ORDER-001). Off unless exactly "true". Never put real keys here;
# BRICKWORKS_AGENT_KEYS holds only SHA-256 hashes and keys are issued only by Filip.
ORDER_DESK_ENABLED=false
ORDER_DESK_ANON_READ=true
ORDER_FLOOR_PUBLIC_VIEW=false
ORDER_FLOOR_SCENARIO=balanced
ORDER_FLOOR_SEED=42
PUBLIC_BASE_URL=
ORDER_DATA_DIR=.data/orders
ORDER_WEBHOOKS_ENABLED=false
BRICKWORKS_AGENT_KEYS=
TRUST_PROXY=false
